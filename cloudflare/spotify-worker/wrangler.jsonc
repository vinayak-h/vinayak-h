{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinayak-spotify-now-playing",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SPOTIFY_STATE",
      "id": "c08828527bed4961ba8d498a6f562db1"
    }
  ]
}
